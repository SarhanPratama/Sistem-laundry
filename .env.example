# =============================================================================
# TEMPLATE KONFIGURASI PRODUKSI
# -----------------------------------------------------------------------------
# Salin file ini menjadi .env di server produksi, lalu sesuaikan nilainya.
# Jangan pernah meng-commit file .env yang berisi kredensial asli.
#
# Untuk pengembangan lokal, gunakan .env.development.example.
# Panduan lengkap: DEPLOYMENT.md
# =============================================================================

APP_NAME="Sistem Manajemen Laundry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# Ganti dengan domain produksi yang sebenarnya (wajib HTTPS).
APP_URL=https://laundry.example.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Hanya dipakai oleh `php artisan serve`; tidak berpengaruh di Nginx/Apache.
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =============================================================================
# DATABASE
# -----------------------------------------------------------------------------
# Produksi disarankan MySQL 8+ atau MariaDB 10.4+ karena migration aplikasi
# memakai tipe ENUM. Buat database dan user khusus aplikasi (jangan root).
#
# Contoh pembuatan database:
#   CREATE DATABASE laundry_management
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'laundry_user'@'localhost' IDENTIFIED BY 'password-kuat';
#   GRANT ALL PRIVILEGES ON laundry_management.* TO 'laundry_user'@'localhost';
#   FLUSH PRIVILEGES;
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundry_management
DB_USERNAME=laundry_user
DB_PASSWORD=

# Opsional: sesuaikan charset/collation bila server memakai konfigurasi lain.
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Alternatif untuk instalasi kecil/single-server (bukan pilihan utama):
# DB_CONNECTION=sqlite
# DB_DATABASE=/path/absolut/ke/database/database.sqlite

# =============================================================================
# SESSION, CACHE, QUEUE
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Wajib true jika situs sudah memakai HTTPS.
# Set false hanya untuk uji coba tanpa HTTPS (tidak disarankan).
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# MAIL
# -----------------------------------------------------------------------------
# Isi dengan kredensial SMTP bila aplikasi akan mengirim email.
# =============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
